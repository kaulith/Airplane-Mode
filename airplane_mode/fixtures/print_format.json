  "html": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif;\n  font-size: 11pt;\n  color: #111;\n}\n\n.print-format {\n  width: 100%;\n}\n\n.header {\n  border-bottom: 3px solid #000;\n  padding-bottom: 12px;\n  margin-bottom: 20px;\n}\n\n.header h1 {\n  margin: 0;\n  font-size: 22pt;\n}\n\n.receipt-id {\n  float: right;\n  font-weight: bold;\n  font-size: 10pt;\n  background: #eee;\n  padding: 6px 10px;\n}\n\n.section-title {\n  font-weight: bold;\n  margin-top: 20px;\n  border-bottom: 2px solid #ddd;\n  padding-bottom: 6px;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 10px;\n}\n\ntd {\n  border: 1px solid #ddd;\n  padding: 10px;\n}\n\n.label {\n  font-size: 9pt;\n  color: #555;\n  text-transform: uppercase;\n}\n\n.value {\n  font-weight: bold;\n}\n\n.amount-box {\n  background: #000;\n  color: #fff;\n  text-align: center;\n  padding: 20px;\n  margin: 20px 0;\n}\n\n.amount-box .label {\n  color: #ccc;\n}\n\n.footer {\n  margin-top: 30px;\n  font-size: 9pt;\n  text-align: center;\n  color: #888;\n}\n</style>\n</head>\n\n<body>\n<div class=\"print-format\">\n\n  <div class=\"header\">\n    <div class=\"receipt-id\">{{ doc.name }}</div>\n    <h1>Rent Payment Receipt</h1>\n    <div>Official payment confirmation</div>\n  </div>\n\n  <div class=\"section-title\">Contract Information</div>\n  <table>\n    <tr>\n      <td>\n        <div class=\"label\">Shop Contract</div>\n        <div class=\"value\">{{ doc.shop_contract }}</div>\n      </td>\n      <td>\n        <div class=\"label\">Tenant</div>\n        <div class=\"value\">{{ frappe.db.get_value(\"Shop Contract\", doc.shop_contract, \"tenant\") }}</div>\n      </td>\n      <td>\n        <div class=\"label\">Shop</div>\n        <div class=\"value\">{{ frappe.db.get_value(\"Shop Contract\", doc.shop_contract, \"shop\") }}</div>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <div class=\"label\">Rent Period Start</div>\n        <div class=\"value\">\n          {{ frappe.utils.formatdate(frappe.db.get_value(\"Shop Contract Payment\", doc.payment_item, \"payment_month\"), \"dd-MM-yyyy\") }}\n        </div>\n      </td>\n      <td>\n        <div class=\"label\">Due Date</div>\n        <div class=\"value\">\n          {{ frappe.utils.formatdate(frappe.db.get_value(\"Shop Contract Payment\", doc.payment_item, \"due_date\"), \"dd-MM-yyyy\") }}\n        </div>\n      </td>\n      <td>\n        <div class=\"label\">Expected Amount</div>\n        <div class=\"value\">\n          {{ frappe.utils.fmt_money(frappe.db.get_value(\"Shop Contract Payment\", doc.payment_item, \"amount_due\"), currency=\"INR\") }}\n        </div>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"amount-box\">\n    <div class=\"label\">Amount Paid</div>\n    <div style=\"font-size:26pt;font-weight:bold;color:#fff;\">\n      {{ frappe.utils.fmt_money(doc.amount_paid, currency=\"INR\") }}\n    </div>\n  </div>\n\n  <div class=\"section-title\">Payment Details</div>\n  <table>\n    <tr>\n      <td style=\"width: 50%;\">\n        <div class=\"label\">Payment Date</div>\n        <div class=\"value\">\n          {{ frappe.utils.formatdate(doc.payment_date, \"dd-MM-yyyy\") }}\n        </div>\n      </td>\n      <td style=\"width: 50%;\">\n        <div class=\"label\">Payment Method</div>\n        <div class=\"value\">{{ doc.payment_method or \"-\" }}</div>\n      </td>\n    </tr>\n    <tr>\n      <td colspan=\"2\">\n        <div class=\"label\">Reference No</div>\n        <div class=\"value\">{{ doc.reference_no or \"-\" }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"footer\">\n    This is a computer-generated receipt and does not require a signature.<br>\n    Generated on {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"dd MMMM yyyy\") }}\n  </div>\n\n</div>\n</body>\n</html>\n",
